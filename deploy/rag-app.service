[Unit]
Description=RAG Knowledge Base Application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/MyProject
ExecStart=/home/ubuntu/MyProject/.venv/bin/streamlit run app/main.py --server.port 8501 --server.headless true
Restart=always
RestartSec=5
Environment="PATH=/home/ubuntu/MyProject/.venv/bin:/usr/local/bin:/usr/bin"
Environment="HOME=/home/ubuntu"

[Install]
WantedBy=multi-user.target
